        "@types/react-dom": "^18.0",
        "jsdom": "^29.1.1",
        "lucide-react": "^1.66.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "shadcn": "latest",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3"
    }
